# ──────────────────────────────────────────────
# API Backend (Railway)
# ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api

# ──────────────────────────────────────────────
# Google Identity Services (OAuth 2.0)
# Obtén tu Client ID en: https://console.cloud.google.com/apis/credentials
# ──────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ──────────────────────────────────────────────
# AWS / SES — solo para la Vercel Function (api/send-email.ts)
# NUNCA agregar prefijo VITE_ — estas variables son server-side únicamente
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
SES_FROM_EMAIL=no-reply@nexopay.com

# URL base del backend Railway — usada por api/send-email.ts para verificar
# la sesión del usuario antes de enviar emails (protección contra spam relay).
# En Vercel: agregar como variable de entorno server-side sin prefijo VITE_.
BACKEND_API_BASE=https://nexopay-api-production.up.railway.app/api

# ──────────────────────────────────────────────
# Gemini API (opcional, para IA desde el cliente)
# ──────────────────────────────────────────────
VITE_GEMINI_API_KEY=your_gemini_api_key_here
