{
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "https://nexopay-api-production.up.railway.app/api/auth/$1"
    },
    {
      "source": "/api/create-checkout/(.*)",
      "destination": "https://nexopay-api-production.up.railway.app/api/create-checkout/$1"
    },
    {
      "source": "/api/rates/(.*)",
      "destination": "https://nexopay-api-production.up.railway.app/api/rates/$1"
    },
    {
      "source": "/api/savings-goals/(.*)",
      "destination": "https://nexopay-api-production.up.railway.app/api/savings-goals/$1"
    },
    {
      "source": "/api/shared-expenses/(.*)",
      "destination": "https://nexopay-api-production.up.railway.app/api/shared-expenses/$1"
    },
    {
      "source": "/api/transactions/(.*)",
      "destination": "https://nexopay-api-production.up.railway.app/api/transactions/$1"
    },
    {
      "source": "/api/wallet/(.*)",
      "destination": "https://nexopay-api-production.up.railway.app/api/wallet/$1"
    },
    { 
      "source": "/((?!api/).*)", 
      "destination": "/index.html" 
    }
  ]
}
